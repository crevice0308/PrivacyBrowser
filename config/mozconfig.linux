# Use only with a source tree prepared by tools/prepare_source.py.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-privacybrowser
ac_add_options --enable-application=browser
ac_add_options --with-branding=browser/branding/privacybrowser
ac_add_options --disable-official-branding
# Match the project developer channel; Gecko enables extended telemetry on
# non-official builds when the implicit upstream channel is "default".
ac_add_options --enable-update-channel=developer
ac_add_options --with-app-name=privacybrowser
ac_add_options --with-app-basename=PrivacyBrowser
export MOZ_APP_REMOTINGNAME=privacybrowser
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --with-redist
ac_add_options --disable-updater
# Keep the default Gecko sandbox, Fission and certificate verification.
# Linux production updates require an independently signed APT repository.
